<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>RdpSwitcher</RootNamespace>
    <AssemblyName>RdpSwitcher</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- Generated by tools\gen-interop.cmd (aximp). Not committed. -->
  <ItemGroup>
    <Reference Include="MSTSCLib">
      <HintPath>Interop\MSTSCLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AxMSTSCLib">
      <HintPath>Interop\AxMSTSCLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
